# ── Vector Store ───────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults — run `make infra-up` first
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/pdfqa

# ── Embedding ─────────────────────────────────────────────────────────────────
# sentence-transformers (CPU, no server needed) — default
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIMENSIONS=384
EMBED_BATCH_SIZE=64

# To use your GPU server instead (vLLM / Ollama / llama.cpp):
# EMBED_MODEL=mxbai-embed-large-v1
# EMBED_BASE_URL=http://192.168.1.x:8080/v1
# EMBED_DIMENSIONS=1024
# EMBED_API_KEY=local

# ── Local GPU Generation Server ────────────────────────────────────────────────
# LLM_MODEL follows ravi-engine's LLMFactory convention:
#   "compatible/<name>" + LLM_BASE_URL  →  any OpenAI-compatible local server
#   "groq/llama-3.3-70b"               →  Groq cloud (set GROQ_API_KEY)
#   "gpt-4o-mini"                      →  OpenAI (set OPENAI_API_KEY)
LLM_BASE_URL=http://192.168.1.x:8080/v1
LLM_MODEL=compatible/llama-3.1-8b-instruct
LLM_API_KEY=local

# ── Pipeline Tuning ────────────────────────────────────────────────────────────
PIPELINE_CONCURRENCY=8
PIPELINE_CHECKPOINT_EVERY=500
PIPELINE_DATA_DIR=data/pdfQA-Annotations
